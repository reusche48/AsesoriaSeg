# ============================================================
# AsesoriaSeg - Control de caché
# Fuerza que el navegador revalide los módulos JS/CSS en cada
# carga. Así cada deploy se ve de inmediato sin necesidad de
# recargar con Ctrl+F5. Si el archivo no cambió, el servidor
# responde 304 (eficiente); si cambió, se descarga la versión nueva.
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # index.html y la API nunca deben cachearse
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Desactivar la caché heurística por Expires para estos tipos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
